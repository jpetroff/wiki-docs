{
  "name": "wiki-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "RAYON_NUM_THREADS=2 bun --bun vite build",
    "start": "bun build/index.js",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "test:smoke": "bun scripts/smoke.ts",
    "prepare": "bun --bun svelte-kit sync",
    "accounts": "bun scripts/accounts.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@bloklabs/core": "^1.13.0",
    "github-slugger": "^2.0.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.56.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "shiki": "^4.4.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "clsx": "^2.1.1",
    "remixicon-svelte": "^0.0.5",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.57.0",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5",
    "vite": "^8.3.0"
  }
}
