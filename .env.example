# Absolute path to an existing documentation folder; leave empty for the scaffold.
DOCS_DIR=

# Keep application data outside DOCS_DIR. No database is created in this pass.
DATABASE_PATH=./data/wiki.sqlite
SITE_TITLE=WikiDocs

# Public origin, including scheme and port. Change for production deployment.
ORIGIN=http://localhost:5173

# Optional overrides; future publishing otherwise uses the checkout's upstream.
GIT_REMOTE=
GIT_BRANCH=
