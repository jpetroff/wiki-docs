# Absolute path to an existing documentation folder; empty returns 503 for reading.
DOCS_DIR=

# Development default. Production requires an absolute path outside DOCS_DIR
# and BUILD_DIR, e.g. /home/eugene/wiki-data/wiki.sqlite.
DATABASE_PATH=./data/wiki.sqlite
SITE_TITLE=WikiDocs

# Public origin, including scheme and port. Change for production deployment.
ORIGIN=http://localhost:5173

# Optional overrides; future publishing otherwise uses the checkout's upstream.
GIT_REMOTE=
GIT_BRANCH=
